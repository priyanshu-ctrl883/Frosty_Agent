# Merchant dashboard — copy to .env.local (Next reads env from THIS directory, not the repo root).
#
# Every value here is NEXT_PUBLIC_*, i.e. inlined into the browser bundle at build time. That is
# correct for all of them and must stay that way: the anon key is designed to be public (it grants
# nothing on its own — RLS and the merchant membership decide everything), and the SERVICE ROLE key
# must NEVER appear in this file. A service-role key in a NEXT_PUBLIC_ variable is a full BYPASSRLS
# credential shipped to every visitor.

# Our API. The parallel build we ported from ran on :8001; ours is :8000.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase project — merchants sign in through Supabase Auth, exactly as staff do. There is no
# `/v1/auth/login` on our API and there is not going to be (D43i). Same project as the API's
# SUPABASE_URL, or `/v1/me` will 401 on a token this app minted against a different one.
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Where the widget's loader is served from. Only the Widget screen reads it, to build the embed
# snippet the merchant pastes into their site.
NEXT_PUBLIC_WIDGET_HOST=http://localhost:5173

# Public URL of this dashboard (no trailing slash). Password-reset emails use this instead of
# relying on Supabase Site URL. Must match an entry in Supabase → Authentication → Redirect URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Meta / WhatsApp Embedded Signup (FB SDK v26.0)
NEXT_PUBLIC_META_APP_ID=
# Configuration ID from Meta App Dashboard → WhatsApp → Embedded Signup
NEXT_PUBLIC_META_CONFIG_ID=
# Optional local fallback — hosted builds also read META_APP_ID / META_EMBEDDED_CONFIG_ID from the API.
