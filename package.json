{
  "name": "@frosty/merchant-dashboard",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev -p 3000",
    "dev:turbo": "next dev -p 3000 --turbopack",
    "clean": "node -e \"try{require('fs').rmSync('.next',{recursive:true,force:true})}catch(e){}\"",
    "dev:e2e": "npm run clean && cross-env NODE_OPTIONS=--max-old-space-size=4096 next dev -p 3000",
    "dev:clean": "cross-env NODE_OPTIONS=--max-old-space-size=4096 node -e \"try{require('fs').rmSync('.next',{recursive:true,force:true})}catch(e){}\" && next dev -p 3000",
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=4096 next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "typecheck": "cross-env NODE_OPTIONS=--max-old-space-size=4096 tsc --noEmit",
    "test": "cross-env NODE_OPTIONS=--max-old-space-size=4096 tsc --noEmit",
    "test:e2e": "npm --prefix ../../scripts/qa/ui_playwright test",
    "test:e2e:ui": "npm --prefix ../../scripts/qa/ui_playwright run test:ui",
    "test:e2e:install": "npm --prefix ../../scripts/qa/ui_playwright run install:browsers"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@gsap/react": "^2.1.2",
    "@next/third-parties": "^16.3.2",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@react-three/drei": "^10.0.0",
    "@react-three/fiber": "^9.0.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.47.0",
    "@xyflow/react": "^12.11.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "framer-motion": "^12.43.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "lucide-react": "^1.28.0",
    "next": "15.3.6",
    "next-themes": "^0.4.6",
    "pnpm": "^11.22.0",
    "react": "^19.0.0",
    "react-countup": "^6.5.3",
    "react-dom": "^19.0.0",
    "react-grid-layout": "^2.2.4",
    "react-resizable": "3.2.0",
    "recharts": "^3.10.1",
    "swr": "^2.5.0",
    "tailwind-merge": "^3.6.0",
    "three": "^0.183.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.183.1",
    "autoprefixer": "^10.5.4",
    "cross-env": "^10.1.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.7.0"
  }
}